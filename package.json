{
  "name": "production-clock",
  "version": "1.0.0",
  "description": "Transparent production clock for video output, with a web control panel.",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --compress GZip",
    "build:win": "pkg . --targets node24-win-x64 --output dist/production-clock-win-x64.exe --compress GZip",
    "build:mac": "pkg . --targets node24-macos-x64,node24-macos-arm64 --compress GZip",
    "build:linux": "pkg . --targets node24-linux-x64 --output dist/production-clock-linux-x64 --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node24-win-x64",
      "node24-macos-x64",
      "node24-macos-arm64",
      "node24-linux-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
